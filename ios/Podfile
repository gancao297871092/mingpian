# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require_relative '../node_modules/expo/scripts/autolinking.rb'

platform :ios, '16.4'

# RN 0.86.0 的预编译 React.xcframework 有缺陷：部分带 debug 宏的符号
# （Sealable 构造/析构、ShadowNode::getDebugName 等）被内部化，
# 与源码编译的第三方 Fabric 组件混链时报 Undefined symbols（上游 0.86.3 已修复）。
# 升级 RN >= 0.86.3 前，iOS 改为全量源码编译 React Core（仅影响 iOS 构建时长）。
# 升级 RN 后删除本行即可恢复预编译。
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'RnBaseTemplate' do
  use_expo_modules!
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  pod 'LiquidGlassView', :path => "#{Pod::Config.instance.installation_root}/LiquidGlassView"

  # 阿里云号码认证一键登录（本地 pod，需先把 ATAuthSDK_D.framework 放入 ios/PhoneLogin/）
  pod 'PhoneLogin', :path => "#{Pod::Config.instance.installation_root}/PhoneLogin"

  # 腾讯云增强版人脸核身（官方 SDK 本地 pod + RN 桥）
  pod 'TencentCloudHuiyanSDKFace_framework', :path => "#{Pod::Config.instance.installation_root}/TencentCloudHuiyanSDKFace_framework"
  pod 'FaceVerify', :path => "#{Pod::Config.instance.installation_root}/FaceVerify"

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # react-native-config：按构建配置选择 .env 文件（Debug→.env，Release→.env.prod）
    # 自定义环境可用 ENVFILE 环境变量覆盖，如：ENVFILE=.env.staging xcodebuild ...
    ENVFILES = {
      'Debug' => '$(PODS_ROOT)/../../.env',
      'Release' => '$(PODS_ROOT)/../../.env.prod',
    }
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if target.name == 'react-native-config'
          config.build_settings['ENVFILE'] = ENVFILES[config.name]
        end
      end
    end

    # WechatOpenSDK-XCFramework 的旧 podspec 带有 EXCLUDED_ARCHS[sdk=iphonesimulator*]=arm64
    # （当年 SDK 无 arm64 模拟器 slice 的规避，现已包含 ios-arm64_x86_64-simulator）。
    # 该设置会传播到聚合 xcconfig，导致整包只编 x86_64、无法装入 Apple Silicon 模拟器。
    # 分三层清除：pod 目标 → 聚合 xcconfig 文件 → App 主目标（目标级覆盖 xcconfig）。
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = ''
      end
    end
    Dir.glob(File.join(installer.sandbox.root, 'Target Support Files/Pods-*/Pods-*.xcconfig')).each do |xcconfig|
      content = File.read(xcconfig)
      next unless content.include?('EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64')
      File.chmod(0o644, xcconfig)
      File.write(xcconfig, content.gsub(%r{^EXCLUDED_ARCHS\[sdk=iphonesimulator\*\] = arm64\n}, ''))
      Pod::UI.puts "Cleared simulator arm64 EXCLUDED_ARCHS in #{File.basename(xcconfig)}".green
    end
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |target|
        target.build_configurations.each do |config|
          config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = ''
        end
      end
    end

    # SVGAPlayer 2.5.7 的 protobuf 生成代码使用了已被新 SDK 移除的
    # OSAtomicCompareAndSwapPtrBarrier，替换为等价的编译器内置函数。
    svga_file = File.join(
      installer.sandbox.root, 'SVGAPlayer/Source/pbobjc/Svga.pbobjc.m'
    )
    if File.exist?(svga_file)
      content = File.read(svga_file)
      # 撤销可能存在的旧补丁（保留已替换结果）
      content = content.gsub(
        '__sync_bool_compare_and_swap(nil, worker, (void * volatile *)&descriptor)',
        'OSAtomicCompareAndSwapPtrBarrier(nil, worker, (void * volatile *)&descriptor)'
      )
      # 原子内置函数不接受 void**，改用带类型的 &descriptor
      content = content.gsub(
        'OSAtomicCompareAndSwapPtrBarrier(nil, worker, (void * volatile *)&descriptor)',
        '__sync_bool_compare_and_swap(&descriptor, nil, worker)'
      )
      # pod install 后 Pods 内文件只读，写入前先放开权限
      File.chmod(0o644, svga_file)
      File.write(svga_file, content)
      Pod::UI.puts 'Patched SVGAPlayer Svga.pbobjc.m (OSAtomic -> __sync)'.green
    end

  end
end
